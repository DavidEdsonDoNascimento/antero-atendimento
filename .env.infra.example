# Antero Atendimentos — infraestrutura LOCAL (Docker Compose).
# Não copie este arquivo à mão: `pnpm infra:env` cria `.env.infra` com senhas
# aleatórias. `.env.infra` é ignorado pelo Git e NUNCA deve ser commitado.
# Nada aqui se conecta ao Supabase, à VPS ou ao Coolify.

# Portas publicadas SOMENTE em 127.0.0.1 (escolhidas fora das usadas por
# antero-pedidos 5433-5435 e antero-cartas 54321-54324).
DEV_DB_PORT=55433
TEST_DB_PORT=55434
MAILPIT_SMTP_PORT=55425
MAILPIT_UI_PORT=55426

# Banco de desenvolvimento (persistente).
DEV_DB_NAME=antero_atendimentos
DEV_ADMIN_PASSWORD=
DEV_MIGRATOR_PASSWORD=
DEV_APP_PASSWORD=
DEV_AUTH_PASSWORD=

# Banco de testes (tmpfs, descartável). O nome DEVE terminar em `_test`.
TEST_DB_NAME=antero_atendimentos_test
TEST_ADMIN_PASSWORD=
TEST_MIGRATOR_PASSWORD=
TEST_APP_PASSWORD=
TEST_AUTH_PASSWORD=
